# =========================
# Database
# =========================
# 将此文件复制为 `backend/.env` 后再填写真实配置，用于本地或服务器部署。
# `DATABASE_URL` 和 `DATABASE_URL_FALLBACK` 必须替换为真实账号密码。
# 只有当大家都连接同一个正式库时，Host / Port / Database 才可以保持不变。
# 不要把真实密码提交到 `.env.example`。
# 生产环境建议使用普通业务账号，不要直接使用超级管理员账号。
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@47.104.168.245:5432/app_db
DATABASE_URL_FALLBACK=postgresql+asyncpg://app_user:CHANGE_ME@47.104.168.245:5432/app_db

# =========================
# App
# =========================
# 一般保留默认值；只有部署目录或服务端口变化时才需要修改。
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
HOST=0.0.0.0
PORT=8000

# Optional DB probe tuning
# 数据库探活配置，一般保留默认值。
DB_CONNECTION_CHECK_INTERVAL_SEC=15
DB_PERMISSION_PROBE_ENABLED=1
DB_PERMISSION_PROBE_SQL=SELECT 1 FROM public.diaries LIMIT 1

# =========================
# OpenAI
# =========================
# 只有当前环境需要 OpenAI 能力时才填写真实 Key。
OPENAI_API_KEY=your_openai_api_key_here

# =========================
# Baidu / Qianfan (optional)
# =========================
# 只有当前环境启用了语音识别、NLP 或千帆能力时才需要替换。
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_SECRET_KEY=your_baidu_secret_key_here
BAIDU_NLP_API_KEY=your_baidu_nlp_api_key_here
BAIDU_NLP_SECRET_KEY=your_baidu_nlp_secret_key_here
QIANFAN_API_KEY=your_qianfan_api_key_here
# 一般保留默认值；如果不想启用文本情绪分析，再改为 `false`。
TEXT_EMOTION_ENABLED=true
# 替换为目标服务器上“外部可访问”的后端地址。
SERVER_BASE_URL=http://localhost:8000

# =========================
# Volcengine Ark (optional)
# =========================
# 只有当前环境启用了绘图/视频生成功能时才需要替换。
ARK_API_KEY=your_ark_api_key_here

# AI 绘图功能开关（控制移动端显示）
# true - 移动端显示 AI 绘图功能（默认）
# false - 移动端不显示 AI 绘图功能
DRAWING_ENABLED=true

# Stable Diffusion 功能开关
# true - 启用 SD 功能（默认）
# false - 禁用 SD 功能，强制使用火山引擎模式
SD_ENABLED=true

# =========================
# OSS (optional)
# =========================
# 如果生产环境使用 OSS，请将 `OSS_ENABLED=true`，并替换下面所有 `OSS_*` 配置。
# 如果生产环境只使用本地存储，保持 `OSS_ENABLED=false` 和 `OSS_FALLBACK_TO_LOCAL=true` 即可。
OSS_ENABLED=false
OSS_FALLBACK_TO_LOCAL=true
# 只有 Bucket 仍在北京地域时才保留该 endpoint，否则请替换。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-beijing.aliyuncs.com
# 一般保留默认值，作为 OSS 中对象存储的前缀目录。
OSS_PREFIX=media/

# =========================
# Security
# =========================
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_DAYS=7
# 日记 title/content 字段级加密（Fernet；可用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成）
FIELD_ENCRYPTION_KEY=
# OSS 私有桶时返回 presigned 临时 URL（1=启用，0=返回公共 URL）
OSS_USE_PRESIGNED_URLS=1
OSS_PRESIGN_EXPIRE_SECONDS=3600
