<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外部存储的图片目录 -->
    <external-files-path
        name="pictures"
        path="Pictures/" />
    
    <!-- 外部存储的视频目录 -->
    <external-files-path
        name="movies"
        path="Movies/" />
    
    <!-- 外部存储的音频目录 -->
    <external-files-path
        name="music"
        path="Music/" />
    
    <!-- 缓存目录 -->
    <cache-path
        name="cache"
        path="/" />
    
    <!-- 外部缓存目录 -->
    <external-cache-path
        name="external_cache"
        path="/" />
</paths>
